# --- marimo / python runtime ---
__marimo__/
__pycache__/
*.pyc
*.pyo

# --- packaging / build residue ---
build/
*.egg-info/
.eggs/
*.whl

# --- virtual environments ---
.venv/
venv/
env/

# --- generated oracle dumps -------------------------------------------------
# These are REGENERATED by a harness on demand and deliberately NOT tracked,
# because producing them needs an external runtime that is not a dependency
# of this project:
#   validation/golden.json       <- node dump_golden.js
#   validation/golden_java.json  <- the Java harness (needs a JDK)
# The GC goldens are the opposite case and ARE tracked: regenerating them
# needs Julia, and shipping them is precisely what lets compare_gc.py and
# compare_gc_program.py run with no external runtime at all.
validation/golden.json
validation/golden_java.json

# --- exported sites / scratch ---
site/
# Root only, on purpose: marimo exports land beside the notebook, but a
# bare *.html would also silently swallow a future docs/ page, which is
# exactly the kind of invisible exclusion that costs an hour to find.
/*.html

# --- editor / OS ---
.DS_Store
.idea/
.vscode/
*.swp

# --- not part of the public repository ----------------------------------
# The oracle validation suites live in the private development tree; if a
# copy is placed here for local runs it must stay untracked.
validation/
